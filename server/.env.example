NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ant_design_pro
MYSQL_USER=ant_design_pro
MYSQL_PASSWORD=replace-with-a-local-secret
MYSQL_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=ant-design-pro-auth-server
JWT_AUDIENCE=ant-design-pro-web
JWT_EXPIRES_IN_SECONDS=7200

# pAI：Key 仅保存在后端；未配置时认证服务仍可启动，但模型接口返回 503。
DEEPSEEK_API_KEY=sk-
DEEPSEEK_MODEL=deepseek-v4-flash

# Mastra Web Search：只保存在后端，用于 Firecrawl Search 请求。
FIRECRAWL_API_KEY=fc-

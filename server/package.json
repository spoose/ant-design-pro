{
  "name": "ant-design-pro-auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mastra:dev": "mastra dev",
    "migrate": "tsx scripts/migrate.ts",
    "research:introduction:local": "tsx scripts/runResearchIntroduction.ts",
    "seed:super-admin": "tsx scripts/seedSuperAdmin.ts",
    "stock:agent:local": "tsx scripts/runStockAgent.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.15",
    "@mastra/core": "^1.54.0",
    "argon2": "^0.45.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firecrawl": "^4.31.1",
    "jose": "^6.2.3",
    "mysql2": "^3.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "mastra": "^1.21.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

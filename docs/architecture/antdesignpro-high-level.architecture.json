  "cards": [
    {
      "dot": "cyan",
      "title": "主要请求路径：已登录 Workspace API",
      "items": [
        "浏览器根据 Workspace URL 派生 organizationId，并附加 Bearer 与 X-Organization-Id。",
        "开发态 Umi 代理把 /api 转发到本地 Express；Express 执行 CORS、Trace、校验与鉴权。",
        "Service 计算 Platform / Organization 权限，Repository 以参数化 SQL 读取 MySQL。",
        "currentUser / 业务 JSON 沿原 HTTP 通道返回，前端据此生成菜单、路由与页面权限。"
      ]
    },
    {
      "dot": "violet",
      "title": "归属与信任边界",
      "items": [
        "当前 codex/auth-frontend 分支拥有 SPA、OpenAPI 客户端与浏览器侧权限门面。",
        "Express、MySQL、pAI 编排位于 codex/experimental-auth-server 工作树，尚未并入当前分支。",
        "Cloudflare Worker 是独立 Hono 演示后端，不与 Express 共享数据库或认证状态。",
        "DeepSeek 与 Firecrawl 位于第三方边界；模型 Key 仅由后端环境配置持有。"
      ]
    },
    {
      "dot": "emerald",
      "title": "支持性运行时细节",
      "items": [
        "前端：Umi Max、React、Ant Design Pro、React Query；OpenAPI 生成 jushu-api 客户端。",
        "浏览器：Access Token 与 pAI 临时会话写入 localStorage；前端权限只控制可见性。",
        "后端：Express 5、Zod、JWT、Argon2id、统一错误包络、Trace ID、MySQL 连接池与事务。",
        "pAI：可注入本地文章和 Firecrawl 结果，再透传 DeepSeek reasoning/content SSE。"
      ]
    },
    {
      "dot": "amber",
      "title": "当前架构差距",
      "items": [
        "生产 baseURL 仍指向 workers.dev 演示 API，与新的 Bearer / RBAC / MySQL 契约不一致。",
        "Express 是否成为正式生产后端、部署位置与前后端最终仓库归属仍未确认。",
        "pAI 尚无服务端会话持久化、向量检索、文件处理、任务队列与审计闭环。",
        "Refresh Token、Redis 撤销列表、生产邮件、监控和生产安全验收仍未完成。"
      ]
    }
  ]

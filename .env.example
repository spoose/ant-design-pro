# Copy to .env.local, replace the example hosts, then run npm run start:xone.
# Development server proxy destination (not exposed to the browser).
XONE_API_TARGET=http://xone.example.test:18086
# Browser-accessible XOne origin; leave empty only for a same-origin gateway.
XONE_PUBLIC_BASE_URL=http://xone.example.test:18086
# Independent entry for ordinary Octop login.
OCTOP_BASE_URL=http://octop.example.test:9000/
# qiankun 3 micro-frontend build entry (not the Vite dev entry).
OCTOP_MICRO_ENTRY=http://localhost:4173/micro.html
